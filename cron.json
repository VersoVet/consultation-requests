{
  "tasks": [
    {
      "id": "imap-monitor",
      "name": "IMAP Email Monitor",
      "description": "Monitor consultations@verso-vet.com for incoming consultation emails",
      "schedule": "*/1 * * * *",
      "command": {
        "type": "endpoint",
        "endpoint": "/cron",
        "method": "GET"
      },
      "enabled": true,
      "timeout_sec": 30,
      "retry": {
        "enabled": true,
        "max_attempts": 3,
        "backoff_sec": 10
      }
    }
  ]
}
